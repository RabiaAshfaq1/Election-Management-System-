# Copy to .env.local and fill in your values

# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=VoteFlow <onboarding@resend.dev>

# Local app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron & internal API (any random strings for local dev)
CRON_SECRET=local-dev-cron-secret
EMAIL_API_SECRET=local-dev-email-secret

# Cloudflare Turnstile (optional locally — leave empty to skip in dev)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
